<web-app>
  <servlet>
    <servlet-name>StudentMemoServlet</servlet-name>
    <servlet-class>student.StudentMemoServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>StudentMemoServlet</servlet-name>
    <url-pattern>/memo</url-pattern>
  </servlet-mapping>
<servlet>
  <servlet-name>InsertStudentServlet</servlet-name>
  <servlet-class>student.InsertStudentServlet</servlet-class>
</servlet>
<servlet-mapping>
  <servlet-name>InsertStudentServlet</servlet-name>
  <url-pattern>/insert</url-pattern>
</servlet-mapping>
  <context-param>
    <param-name>contextConfigLocation</param-name>
    <param-value>/WEB-INF/spring-config.xml</param-value>
  </context-param>

  <listener>
    <listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
  </listener>

</web-app>
